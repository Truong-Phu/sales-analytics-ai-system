# AI Service – FastAPI + Prophet (Python 3.13)
FROM python:3.13-slim

WORKDIR /app

# Cài đặt system dependencies (Prophet cần pystan build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy và install Python dependencies
COPY src/ai-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ai-service/ .

# Copy model (nếu đã train) – bỏ qua nếu models/ chưa có file
COPY src/ai-service/models/ ./models/

EXPOSE 8001

# Biến môi trường mặc định
ENV DB_HOST=postgres
ENV DB_PORT=5432
ENV DB_NAME=sales_analytics_ai_db
ENV DB_USER=postgres
ENV DB_PASSWORD=postgres

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
