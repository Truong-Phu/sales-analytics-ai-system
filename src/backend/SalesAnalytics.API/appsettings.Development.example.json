// Sao chép file này thành appsettings.Development.json
// và điền giá trị thật vào trước khi chạy backend
// KHÔNG commit appsettings.Development.json lên GitHub
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sales_analytics_ai_db;Username=postgres;Password=YOUR_DB_PASSWORD_HERE"
  },

  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "SalesAnalyticsAPI",
    "Audience": "SalesAnalyticsClient",
    "AccessTokenMinutes": "60",
    "RefreshTokenDays": "30"
  },

  "AiService": {
    "BaseUrl": "http://localhost:8001"
  },

  "Resend": {
    "ApiKey": "SET_IN_USER_SECRETS",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "MSAS - SalesAnalytics",
    "OtpSalt": "SET_IN_USER_SECRETS"
  },

  "Email": {
    "DevOverrideTo": ""
  },

  "Gemini": {
    "ApiKey": "SET_IN_USER_SECRETS",
    "Model": "gemini-2.5-flash-preview-05-20"
  },

  "Groq": {
    "ApiKey": "SET_IN_USER_SECRETS",
    "Model": "llama-3.3-70b-versatile"
  },

  "Encryption": {
    "Key": "GENERATE_64_HEX_CHARS_openssl_rand_hex_32"
  },

  "SePay": {
    "ApiKey": "YOUR_SEPAY_API_KEY_HERE"
  },

  "AppBaseUrl": "https://YOUR_NGROK_URL_HERE"
}
