// Sao chép file này thành appsettings.Development.json
// và điền giá trị thật vào trước khi chạy backend
// KHÔNG commit appsettings.Development.json lên GitHub
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sales_analytics_ai_db;Username=postgres;Password=YOUR_DB_PASSWORD_HERE"
  },

  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "SalesAnalyticsAPI",
    "Audience": "SalesAnalyticsClient",
    "AccessTokenMinutes": "60",
    "RefreshTokenDays": "30"
  },

  "AiService": {
    "BaseUrl": "http://localhost:8001"
  }
}
