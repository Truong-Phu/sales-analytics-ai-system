{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sales_analytics_ai_db;Username=postgres;Password=YOUR_DB_PASSWORD"
  },

  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "SalesAnalyticsAPI",
    "Audience": "SalesAnalyticsClient",
    "AccessTokenMinutes": "60",
    "RefreshTokenDays": "30"
  },

  "AiService": {
    "BaseUrl": "http://localhost:8001"
  }
}
