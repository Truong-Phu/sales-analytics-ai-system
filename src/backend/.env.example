# ============================================================
# Backend — ASP.NET Core 9
# ============================================================
# Các biến này được đọc từ appsettings.json / appsettings.Development.json
# hoặc Environment Variables khi chạy dotnet run.
#
# HƯỚNG DẪN:
#   copy .env.example .env
#   Điền giá trị thật vào .env (KHÔNG commit .env lên git)
#
# Với ASP.NET Core, có thể set environment variable theo 2 cách:
#   1. Tạo file .env và dùng dotenv (không native — cần thư viện)
#   2. Set trong appsettings.Development.json (khuyến nghị khi dev)
#   3. Set trực tiếp trong terminal: $env:VARIABLE=value (PowerShell)
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Chuỗi kết nối PostgreSQL — phải khớp với ConnectionStrings:Default trong appsettings
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
CONNECTION_STRING=Host=localhost;Port=5432;Database=sales_analytics_ai_db;Username=postgres;Password=your_password_here

# ── JWT ──────────────────────────────────────────────────────
# Secret key để ký JWT token — tối thiểu 32 ký tự
# Tạo ngẫu nhiên: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# Thời gian JWT Access Token hết hạn (phút)
JWT_EXPIRY_MINUTES=60

# Thời gian JWT Refresh Token hết hạn (ngày)
JWT_REFRESH_DAYS=30

# Issuer và Audience — phải khớp với cấu hình frontend/mobile
JWT_ISSUER=SalesAnalyticsAPI
JWT_AUDIENCE=SalesAnalyticsClient

# ── AI SERVICE PROXY ─────────────────────────────────────────
# URL FastAPI AI Service — AiController forward request sang đây
# Phải khớp với AiService:BaseUrl trong appsettings.json
AI_SERVICE_URL=http://localhost:8001

# ── SERVER ───────────────────────────────────────────────────
# Môi trường chạy (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Cổng backend — phải khớp với proxy target trong src/frontend/vite.config.js
ASPNETCORE_URLS=http://localhost:5136

# ── LOCALIZATION ─────────────────────────────────────────────
# Ngôn ngữ mặc định trả về từ API khi không có Accept-Language header
DEFAULT_LANGUAGE=vi

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=Information
