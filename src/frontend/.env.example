# ============================================================
# Frontend — React 18 + Vite
# ============================================================
# Biến phải có prefix VITE_ để Vite expose ra trình duyệt
# KHÔNG đặt secret (API key, password...) ở đây — người dùng cuối có thể xem được
#
# HƯỚNG DẪN:
#   cd src/frontend
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux/Mac)
#   Điền giá trị thật vào .env
# ============================================================

# ── API ──────────────────────────────────────────────────────
# URL backend API — để trống ("") khi dùng Vite proxy (dev)
# Production: đặt URL thật, ví dụ https://api.yourdomain.com
# Phải khớp với tên biến trong src/api/axios.js: import.meta.env.VITE_API_URL
VITE_API_URL=

# Timeout khi gọi API (milliseconds)
VITE_API_TIMEOUT=10000

# Bật/tắt mock data khi API lỗi (true/false)
# true  → hiển thị banner vàng "Đang dùng dữ liệu mẫu"
# false → hiển thị lỗi thật
VITE_USE_MOCK_FALLBACK=true

# ── APP INFO ─────────────────────────────────────────────────
# Tên app hiển thị trên tab trình duyệt và header
VITE_APP_NAME=Sales Analytics AI

# Ngôn ngữ mặc định khi người dùng vào lần đầu (vi / en)
VITE_DEFAULT_LANGUAGE=vi
