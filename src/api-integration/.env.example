# ============================================================
# .env.example – Biến môi trường cho API Integration Layer
# Hệ thống: MSAS – Multi-channel Sales Analytics System
# ============================================================
# HƯỚNG DẪN:
#   cp .env.example .env
#   Điền đầy đủ giá trị vào .env (KHÔNG commit .env lên git)
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Ưu tiên DATABASE_URL nếu có, ngược lại dùng từng biến riêng
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sales_analytics_ai_db

# Hoặc cấu hình từng biến:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_analytics_ai_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# ── SHOPEE OPEN API v2 ────────────────────────────────────────
# Đăng ký tại: https://open.shopee.com/
# Cần: Partner ID, Partner Key, và hoàn thành OAuth2 để lấy Access Token
SHOPEE_PARTNER_ID=your_partner_id
SHOPEE_PARTNER_KEY=your_partner_key
SHOPEE_ACCESS_TOKEN=your_access_token
SHOPEE_REFRESH_TOKEN=your_refresh_token
SHOPEE_SHOP_ID=your_shop_id
# Dùng sandbox khi dev (thay đổi BASE_URL trong shopee.py)
# SHOPEE_USE_SANDBOX=true

# ── LAZADA OPEN PLATFORM ──────────────────────────────────────
# Đăng ký tại: https://open.lazada.com/
LAZADA_APP_KEY=your_app_key
LAZADA_APP_SECRET=your_app_secret
LAZADA_ACCESS_TOKEN=your_access_token
LAZADA_REFRESH_TOKEN=your_refresh_token

# ── TIKTOK SHOP PARTNER API ───────────────────────────────────
# Đăng ký tại: https://partner.tiktokshop.com/
TIKTOK_APP_KEY=your_app_key
TIKTOK_APP_SECRET=your_app_secret
TIKTOK_ACCESS_TOKEN=your_access_token
TIKTOK_REFRESH_TOKEN=your_refresh_token
TIKTOK_SHOP_ID=your_shop_id

# ── FACEBOOK GRAPH API ────────────────────────────────────────
# Tạo App tại: https://developers.facebook.com/
# Cần: Page Access Token (long-lived, 60 ngày)
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_AD_ACCOUNT_ID=act_your_ad_account_id
FACEBOOK_API_VERSION=v19.0

# ── GOOGLE ANALYTICS 4 ───────────────────────────────────────
# Tạo Service Account tại: https://console.cloud.google.com/
# Cấp quyền "Viewer" cho property GA4
GA4_PROPERTY_ID=properties/YOUR_PROPERTY_ID
# Cách 1: Đường dẫn tới file JSON key
GA4_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# Cách 2: JSON string trực tiếp (base64 hoặc escaped)
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── GHN (GIAO HÀNG NHANH) ─────────────────────────────────────
# Đăng ký tại: https://api.ghn.vn/
GHN_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id

# ── GHTK (GIAO HÀNG TIẾT KIỆM) ───────────────────────────────
GHTK_TOKEN=your_ghtk_api_token

# ── VNPAY ─────────────────────────────────────────────────────
# Đăng ký Merchant tại: https://vnpay.vn/
VNPAY_TMN_CODE=your_terminal_id
VNPAY_SECRET_KEY=your_secret_key
# Sandbox: https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Production: https://vnpayment.vn/merchant_webapi/api/transaction
VNPAY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ── MOMO ──────────────────────────────────────────────────────
# Đăng ký tại: https://business.momo.vn/
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key

# ── ETL SCHEDULER ─────────────────────────────────────────────
# Cron expression cho lịch tự động chạy ETL
ETL_SCHEDULE_SHOPEE=0 */2 * * *    # Mỗi 2 giờ
ETL_SCHEDULE_LAZADA=0 */3 * * *    # Mỗi 3 giờ
ETL_SCHEDULE_TIKTOK=0 */2 * * *    # Mỗi 2 giờ
ETL_SCHEDULE_FACEBOOK=0 6 * * *    # 6 giờ sáng hàng ngày
ETL_SCHEDULE_GHN=0 */4 * * *       # Mỗi 4 giờ

# ── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR | CRITICAL
