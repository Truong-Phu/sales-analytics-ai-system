# ============================================================
# API Integration — Connectors
# Hệ thống: MSAS – Multi-channel Sales Analytics System
# ============================================================
# Mỗi connector đọc biến của mình từ file này qua load_dotenv().
# Để trống nếu chưa có key → connector tự fallback sang CSV import.
#
# HƯỚNG DẪN:
#   cd src/api-integration
#   copy .env.example .env
#   Điền các key bạn đã đăng ký vào .env
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Ưu tiên DATABASE_URL nếu có, ngược lại dùng từng biến riêng bên dưới
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sales_analytics_ai_db

# Cấu hình từng biến (dùng khi không set DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_analytics_ai_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── SCRAPING CONFIG ───────────────────────────────────────────
# Từ khóa tìm kiếm Google/DuckDuckGo, phân cách dấu phẩy
GOOGLE_KEYWORDS=xu huong ban hang online,san pham ban chay shopee,gia ban le viet nam,top san pham tiktok shop

# Facebook page URL do bạn sở hữu, phân cách dấu phẩy
# DISCLAIMER: Chỉ scrape page do chính bạn tạo và kiểm soát
FACEBOOK_PAGE_URLS=https://www.facebook.com/your-page-name

# Delay ngẫu nhiên giữa các request (giây) — tránh bị chặn
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5

# ── SHOPEE OPEN API v2 ────────────────────────────────────────
# Đăng ký tại: https://open.shopee.com/
# Cần hoàn thành OAuth2 flow để lấy Access Token + Shop ID
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SHOP_ID=
# Uncomment để dùng sandbox khi dev:
# SHOPEE_USE_SANDBOX=true

# ── LAZADA OPEN PLATFORM ──────────────────────────────────────
# Đăng ký tại: https://open.lazada.com/
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
LAZADA_REFRESH_TOKEN=

# ── TIKTOK SHOP PARTNER API ───────────────────────────────────
# Đăng ký tại: https://partner.tiktokshop.com/
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_ID=

# ── FACEBOOK GRAPH API ────────────────────────────────────────
# Tạo App tại: https://developers.facebook.com/
# Cần: Page Access Token long-lived (60 ngày)
# Đây là token cho Graph API, khác với FACEBOOK_PAGE_URLS cho scraper
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_API_VERSION=v19.0

# ── GOOGLE ANALYTICS 4 ───────────────────────────────────────
# Tạo Service Account tại: https://console.cloud.google.com/
# Property ID lấy trong GA4 Admin (format: properties/123456789)
GA4_PROPERTY_ID=properties/YOUR_PROPERTY_ID
# Cách 1: Đường dẫn tới file JSON key (đặt trong credentials/ — đã gitignore)
GA4_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
# Cách 2: JSON string trực tiếp trong env
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── GHN (GIAO HÀNG NHANH) ─────────────────────────────────────
# Đăng ký tại: https://api.ghn.vn/
GHN_TOKEN=
GHN_SHOP_ID=

# ── GHTK (GIAO HÀNG TIẾT KIỆM) ───────────────────────────────
GHTK_TOKEN=

# ── VNPAY ─────────────────────────────────────────────────────
# Đăng ký Merchant tại: https://vnpay.vn/
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
# Sandbox để test, đổi sang production khi deploy:
VNPAY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ── MOMO ──────────────────────────────────────────────────────
# Đăng ký tại: https://business.momo.vn/
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ── ZALOPAY ───────────────────────────────────────────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# ── OPENWEATHERMAP ────────────────────────────────────────────
# Lấy tại: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
DEFAULT_CITY=Ho Chi Minh City,VN

# ── ETL SCHEDULE ─────────────────────────────────────────────
# Cron expression cho từng connector (nếu dùng scheduler riêng)
ETL_SCHEDULE_SHOPEE=0 */2 * * *
ETL_SCHEDULE_LAZADA=0 */3 * * *
ETL_SCHEDULE_TIKTOK=0 */2 * * *
ETL_SCHEDULE_FACEBOOK=0 6 * * *
ETL_SCHEDULE_GHN=0 */4 * * *

# ── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# Lưu log ra file hay không (true/false)
LOG_TO_FILE=true

# Đường dẫn thư mục lưu log (mặc định: ./logs)
LOG_DIR=./logs
