# ============================================================
# ETL Pipeline — Python
# ============================================================
# Dùng cho: pipeline.py, scheduler.py, extract.py, load.py
# Đọc bằng python-dotenv: load_dotenv() ở đầu mỗi file
#
# HƯỚNG DẪN:
#   cd src/etl
#   copy .env.example .env
#   Điền giá trị thật vào .env
# ============================================================

# ── DATABASE OLTP (nguồn) ────────────────────────────────────
# Kết nối PostgreSQL OLTP — nguồn dữ liệu cho ETL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sales_analytics_ai_db

# ── DATABASE DATA WAREHOUSE (đích) ───────────────────────────
# Kết nối PostgreSQL DW — đích load dữ liệu sau ETL
# Nếu dùng chung 1 DB thì để giống DATABASE_URL
DW_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sales_analytics_ai_db

# ── ETL PIPELINE CHÍNH ───────────────────────────────────────
# Cron expression cho pipeline chính (mặc định mỗi 6 tiếng)
# Định dạng: "phút giờ ngày tháng ngày-tuần"
# Ví dụ: "0 */6 * * *" = chạy vào phút 0 mỗi 6 tiếng
ETL_SCHEDULE_CRON=0 */6 * * *

# Số bản ghi xử lý mỗi batch (tránh tốn RAM khi dữ liệu lớn)
ETL_BATCH_SIZE=500

# Timezone cho APScheduler
ETL_TIMEZONE=Asia/Ho_Chi_Minh

# ── SCRAPER CONFIG ────────────────────────────────────────────
# Danh sách từ khóa Google/DuckDuckGo scraping, phân cách dấu phẩy
GOOGLE_KEYWORDS=xu huong ban hang online,san pham ban chay shopee,gia ban le viet nam

# Facebook page URL do bạn sở hữu, phân cách dấu phẩy
# DISCLAIMER: Chỉ scrape page do chính bạn tạo và kiểm soát
FACEBOOK_PAGE_URLS=https://www.facebook.com/your-page-name

# Delay ngẫu nhiên giữa các request scraping (giây)
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5

# ── LOGGING ──────────────────────────────────────────────────
# Mức log: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Lưu log ra file hay không (true/false)
LOG_TO_FILE=true

# Đường dẫn thư mục lưu log
LOG_DIR=./logs
