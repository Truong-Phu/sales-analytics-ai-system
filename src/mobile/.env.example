# ============================================================
# Mobile — React Native + Expo
# ============================================================
# Biến phải có prefix EXPO_PUBLIC_ để Expo expose ra runtime
# KHÔNG đặt secret ở đây — bundle có thể bị decompile
#
# HƯỚNG DẪN:
#   cd src/mobile
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux/Mac)
#   Điền IP LAN của máy tính (KHÔNG dùng localhost trên thiết bị thật)
#
# Tìm IP LAN:
#   Windows → ipconfig | findstr IPv4
#   Mac/Linux → ifconfig | grep inet
# Máy tính và điện thoại phải cùng mạng WiFi
# ============================================================

# ── API ──────────────────────────────────────────────────────
# URL backend API — thay <IP_LAN_MAY_TINH> bằng IP thật của máy bạn
# Ví dụ: http://192.168.1.100:5136
# Phải khớp với biến trong src/api/axios.js: process.env.EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_URL=http://<IP_LAN_MAY_TINH>:5136

# Timeout API mobile (cao hơn web vì mạng di động có thể chậm)
EXPO_PUBLIC_API_TIMEOUT=15000

# Bật mock data fallback khi API không kết nối được (true/false)
EXPO_PUBLIC_USE_MOCK_FALLBACK=true

# ── APP INFO ─────────────────────────────────────────────────
# Tên app mobile
EXPO_PUBLIC_APP_NAME=Sales Analytics

# Ngôn ngữ mặc định (vi / en)
EXPO_PUBLIC_DEFAULT_LANGUAGE=vi
