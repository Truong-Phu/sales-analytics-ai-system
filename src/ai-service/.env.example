# ============================================================
# AI Service — FastAPI + Python
# ============================================================
# Đọc bằng python-dotenv: load_dotenv() trong main.py
#
# HƯỚNG DẪN:
#   cd src/ai-service
#   copy .env.example .env
#   Điền giá trị thật vào .env
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Kết nối PostgreSQL — dùng để query context cho AI và đọc DW
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sales_analytics_ai_db

# ── AI API KEYS ──────────────────────────────────────────────
# Điền 1 trong 2 key bên dưới để dùng AI thật.
# Nếu cả hai để trống → hệ thống tự động dùng rule-based fallback.
# Ưu tiên: Anthropic (Claude) → OpenAI → rule-based

# Anthropic Claude API key
# Lấy tại: https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key (fallback nếu không có Anthropic)
# Lấy tại: https://platform.openai.com
OPENAI_API_KEY=

# Model AI sử dụng cho recommendation endpoint
# Claude Haiku: nhanh + rẻ, phù hợp SME
AI_MODEL=claude-haiku-4-5-20251001

# ── PROPHET MODEL ────────────────────────────────────────────
# Đường dẫn file model Prophet đã train trên Google Colab
# Đặt file .pkl vào src/ai-service/models/ sau khi train xong
PROPHET_MODEL_PATH=models/prophet_revenue.pkl

# Số ngày dự báo mặc định khi không truyền tham số horizon
FORECAST_HORIZON_DAYS=30

# ── CONFIDENCE CONFIG ────────────────────────────────────────
# Số bản ghi tối thiểu trong DW để confidence nâng từ "low" lên "medium"
AI_CONFIDENCE_THRESHOLD=5

# ── SERVER CONFIG ────────────────────────────────────────────
# Cổng FastAPI chạy (phải khớp với AiService:BaseUrl trong appsettings.json)
AI_SERVICE_PORT=8001

# Origins được phép gọi API (CORS) — phân cách dấu phẩy
# Thêm URL frontend và backend vào đây
CORS_ORIGINS=http://localhost:5173,http://localhost:5136,http://localhost:3000

# ── LOGGING ──────────────────────────────────────────────────
# Mức log: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
