# ============================================================
# .env.example — BIẾN MÔI TRƯỜNG TOÀN HỆ THỐNG
# Hệ thống: MSAS – Multi-channel Sales Analytics System
# ============================================================
# HƯỚNG DẪN:
#   cp .env.example .env          (Linux/Mac)
#   copy .env.example .env        (Windows)
#   Sau đó điền giá trị thật vào .env
# KHÔNG commit file .env lên GitHub
# ============================================================

# ── DATABASE (PostgreSQL 17) ─────────────────────────────────
# Host kết nối PostgreSQL (local: localhost, docker: postgres)
DB_HOST=localhost

# Cổng PostgreSQL mặc định
DB_PORT=5432

# Tên database (OLTP + Raw Layer)
DB_NAME=sales_analytics_ai_db

# Tên database Data Warehouse (có thể dùng chung 1 DB)
DB_WAREHOUSE_NAME=sales_analytics_ai_db

# Tên user PostgreSQL
DB_USER=postgres

# Mật khẩu PostgreSQL — đặt mật khẩu mạnh khi deploy
DB_PASSWORD=your_password_here

# Connection string đầy đủ cho ASP.NET Core
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
CONNECTION_STRING=Host=localhost;Port=5432;Database=sales_analytics_ai_db;Username=postgres;Password=your_password_here

# Connection string cho Python (psycopg2)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sales_analytics_ai_db

# ── BACKEND (ASP.NET Core 9) ─────────────────────────────────
# Cổng backend chạy local (phải khớp với proxy target trong vite.config.js)
BACKEND_PORT=5136

# URL backend đầy đủ
BACKEND_URL=http://localhost:5136

# Khóa bí mật để ký JWT — tối thiểu 32 ký tự, random string
# Tạo ngẫu nhiên: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# Thời gian JWT Access Token hết hạn (phút)
JWT_EXPIRY_MINUTES=60

# Thời gian JWT Refresh Token hết hạn (ngày)
JWT_REFRESH_DAYS=30

# Issuer và Audience cho JWT (phải khớp giữa backend và client)
JWT_ISSUER=SalesAnalyticsAPI
JWT_AUDIENCE=SalesAnalyticsClient

# Môi trường chạy (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# ── AI SERVICE (FastAPI + Python) ────────────────────────────
# Cổng FastAPI AI service (phải khớp với AiService:BaseUrl trong appsettings)
AI_SERVICE_PORT=8001

# URL FastAPI AI service đầy đủ
AI_SERVICE_URL=http://localhost:8001

# API key Claude (Anthropic) — để trống nếu muốn dùng rule-based fallback
# Lấy tại: https://console.anthropic.com
ANTHROPIC_API_KEY=

# API key OpenAI — fallback nếu không có Anthropic key
# Lấy tại: https://platform.openai.com
OPENAI_API_KEY=

# Model AI sử dụng (Haiku: nhanh + rẻ, phù hợp SME)
AI_MODEL=claude-haiku-4-5-20251001

# Đường dẫn file model Prophet đã train (để trong src/ai-service/models/)
PROPHET_MODEL_PATH=models/prophet_revenue.pkl

# Số ngày dự báo mặc định
FORECAST_HORIZON_DAYS=30

# Ngưỡng số bản ghi DW để confidence nâng lên "medium"
AI_CONFIDENCE_THRESHOLD=5

# Origins được phép gọi FastAPI (CORS) — phân cách dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:5136,http://localhost:3000

# ── SCRAPING CONFIG ──────────────────────────────────────────
# Chế độ scraper: "online" (scrape thật) hoặc "offline" (dùng CSV mẫu, không cần mạng)
# Đổi thành "online" khi có mạng không bị block (DDG/Bing khả dụng)
# Đổi thành "offline" khi dev/test để bỏ qua scrape mạng, tải từ sample_google_data.csv
SCRAPER_MODE=offline

# Từ khóa tìm kiếm Google/DuckDuckGo, phân cách dấu phẩy
GOOGLE_KEYWORDS=xu huong ban hang online,san pham ban chay shopee,gia ban le viet nam,top san pham tiktok shop

# Delay tối thiểu giữa các request scraping (giây)
SCRAPER_DELAY_MIN=2

# Delay tối đa giữa các request scraping (giây)
SCRAPER_DELAY_MAX=5

# Facebook page URL do bạn sở hữu, phân cách dấu phẩy
# DISCLAIMER: Chỉ scrape page do chính bạn tạo và kiểm soát
FACEBOOK_PAGE_URLS=https://www.facebook.com/your-page-name

# [TÙY CHỌN] Facebook cookies để get_posts() hoạt động với profile cá nhân
# Lấy từ trình duyệt: F12 → Application → Cookies → facebook.com
# Để trống nếu dùng SCRAPER_MODE=offline hoặc scrape page công khai
# CẢNH BÁO: Không dùng tài khoản chính – dùng tài khoản test riêng
FB_COOKIE_C_USER=
FB_COOKIE_XS=

# ── ETL SCHEDULER ────────────────────────────────────────────
# Cron expression cho ETL pipeline chính (mặc định mỗi 6 tiếng)
ETL_SCHEDULE_CRON=0 */6 * * *

# Số bản ghi xử lý mỗi batch ETL
ETL_BATCH_SIZE=500

# Timezone cho APScheduler
ETL_TIMEZONE=Asia/Ho_Chi_Minh

# ── FRONTEND (React 18 + Vite) ───────────────────────────────
# URL backend API — prefix VITE_ bắt buộc để Vite expose ra trình duyệt
# Biến này được dùng trong src/frontend/src/api/axios.js
VITE_API_URL=http://localhost:5136/api

# Ngôn ngữ mặc định khi người dùng vào lần đầu (vi / en)
VITE_DEFAULT_LANGUAGE=vi

# Tên app hiển thị trên tab trình duyệt
VITE_APP_NAME=Sales Analytics AI

# Timeout khi gọi API (milliseconds)
VITE_API_TIMEOUT=10000

# Bật/tắt mock data khi API lỗi (true/false)
VITE_USE_MOCK_FALLBACK=true

# ── MOBILE (React Native Expo) ───────────────────────────────
# URL backend API — KHÔNG dùng localhost trên thiết bị thật
# Tìm IP LAN: Windows → ipconfig | findstr IPv4
# Máy tính và điện thoại phải cùng mạng WiFi
EXPO_PUBLIC_API_URL=http://192.168.1.x:5136/api

# Ngôn ngữ mặc định mobile
EXPO_PUBLIC_DEFAULT_LANGUAGE=vi

# Tên app mobile
EXPO_PUBLIC_APP_NAME=Sales Analytics

# Timeout API mobile (cao hơn web vì mạng di động có thể chậm)
EXPO_PUBLIC_API_TIMEOUT=15000

# Bật mock data fallback khi API không kết nối được
EXPO_PUBLIC_USE_MOCK_FALLBACK=true

# ── DOCKER ───────────────────────────────────────────────────
# PostgreSQL password dùng chung trong docker-compose
POSTGRES_PASSWORD=your_strong_password_here

# Cổng expose ra host khi chạy docker-compose
DOCKER_BACKEND_PORT=5136
DOCKER_FRONTEND_PORT=5173
DOCKER_AI_PORT=8001
DOCKER_DB_PORT=5432

# ── API INTEGRATION — SHOPEE ─────────────────────────────────
# Đăng ký tại: https://open.shopee.com
# Để trống → connector tự dùng CSV fallback
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SHOP_ID=

# ── API INTEGRATION — LAZADA ─────────────────────────────────
# Đăng ký tại: https://open.lazada.com
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
LAZADA_REFRESH_TOKEN=

# ── API INTEGRATION — TIKTOK SHOP ────────────────────────────
# Đăng ký tại: https://partner.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_ID=

# ── API INTEGRATION — FACEBOOK GRAPH API ─────────────────────
# Tạo App tại: https://developers.facebook.com
# Đây là Graph API token, khác với FACEBOOK_PAGE_URLS cho scraper
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_API_VERSION=v19.0

# ── API INTEGRATION — GOOGLE ANALYTICS 4 ─────────────────────
# Property ID trong GA4 Admin (format: properties/123456789)
GA4_PROPERTY_ID=properties/YOUR_PROPERTY_ID
# File JSON service account — đặt vào src/api-integration/credentials/
GA4_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json

# ── API INTEGRATION — GHN (Giao Hàng Nhanh) ─────────────────
# Đăng ký tại: https://api.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=

# ── API INTEGRATION — GHTK (Giao Hàng Tiết Kiệm) ────────────
GHTK_TOKEN=

# ── API INTEGRATION — VNPAY ──────────────────────────────────
# Đăng ký Merchant tại: https://vnpay.vn
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
# Dùng sandbox khi dev, đổi sang URL production khi deploy
VNPAY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ── API INTEGRATION — MOMO ───────────────────────────────────
# Đăng ký tại: https://business.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ── API INTEGRATION — ZALOPAY ────────────────────────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# ── API INTEGRATION — OpenWeatherMap ─────────────────────────
# Lấy tại: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
DEFAULT_CITY=Ho Chi Minh City,VN

# ── LOGGING ──────────────────────────────────────────────────
# Mức log: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Lưu log ra file hay không (true/false)
LOG_TO_FILE=true

# Đường dẫn thư mục lưu log
LOG_DIR=./logs
